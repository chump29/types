{
  "name": "@postfmly/types",
  "version": "1.0.3",
  "description": "Custom TypeScript types",
  "keywords": [
    "custom",
    "typescript",
    "types"
  ],
  "homepage": "https://github.com/chump29/types",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/types.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Chris Post",
    "email": "admin@postfmly.com"
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "bun run --bun bunup",
    "check": "bunx --bun depcheck --ignores=\"@types/*\" || :",
    "preinstall": "bunx --bun only-allow bun",
    "lint": "bun run scan && bun run lint:spell && bun run lint:biome && bun run lint:ts",
    "lint:biome": "bun run --bun biome check --write --verbose --error-on-warnings",
    "lint:spell": "bun run --bun cspell --dot --verbose .",
    "lint:ts": "bun run --bun tsc",
    "prepare": "bun run --bun husky",
    "scan": "bun audit && bun run --bun cve-lite --check-overrides",
    "scan:e18e": "bunx --bun @e18e/cli analyze",
    "updates": "bunx --bun npm-check-updates --dep overrides,dev --cooldown 0 --install never --packageManager bun --peer"
  },
  "lint-staged": {
    "*": "bun run --bun cspell --no-must-find-files",
    "*.{json,ts}": "bun run --bun biome ci --error-on-warnings --no-errors-on-unmatched"
  },
  "overrides": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.3",
    "chalk": "6.0.1",
    "cspell": "10.3.4",
    "cve-lite-cli": "1.37.0",
    "globals": "17.12.0",
    "ini": "7.0.0",
    "strip-json-comments": "5.0.3",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@postfmly/config": "^1.4.79",
    "bunup": "^0.16.32",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "^1.4.2"
  },
  "engineStrict": true
}
