{
  "name": "@postfmly/types",
  "version": "1.0.8",
  "description": "Custom TypeScript types",
  "keywords": [
    "custom",
    "typescript",
    "types"
  ],
  "homepage": "https://github.com/chump29/types",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/types.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Chris Post",
    "email": "admin@postfmly.com"
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "bun run --bun bunup",
    "deps": "bunx --bun depcheck --ignores=\"@postfmly/config,@types/*\"",
    "preinstall": "bunx --bun only-allow bun",
    "lint": "bun run lint:spell && bun run lint:biome && bun run lint:ts",
    "lint:biome": "bun run --bun biome check --write --verbose --error-on-warnings",
    "lint:spell": "bun run --bun cspell --dot .",
    "lint:ts": "bun check",
    "prepare": "bun run --bun husky",
    "scan": "bun run scan:audit && bun run scan:e18e",
    "scan:audit": "bun audit --prod",
    "scan:e18e": "bunx --bun @e18e/cli analyze",
    "updates": "bunx --bun npm-check-updates --dep overrides,dev --cooldown 0 --install never --packageManager bun --peer"
  },
  "lint-staged": {
    "*": "bun run --bun cspell --no-must-find-files",
    "*.{json,ts}": "bun run --bun biome ci --error-on-warnings --no-errors-on-unmatched"
  },
  "overrides": {
    "chalk": "6.0.1",
    "undici-types": "8.12.3"
  },
  "devDependencies": {
    "@postfmly/config": "^1.6.10",
    "bunup": "^0.16.32",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": "^1.4.3"
  },
  "engineStrict": true
}
