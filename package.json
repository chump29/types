{
  "name": "@postfmly/types",
  "version": "1.0.1",
  "description": "Custom TypeScript types",
  "keywords": [
    "custom",
    "typescript",
    "types"
  ],
  "homepage": "https://github.com/chump29/types",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chump29/types.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Chris Post",
    "email": "admin@postfmly.com"
  },
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "bun run build:clean && bun run build:dts && bun run build:copy",
    "build:clean": "bun run --bun rimraf dist",
    "build:copy": "cp -f LICENSE package.json README.md dist/",
    "build:dts": "bun run --bun tsc --declaration --emitDeclarationOnly --outDir dist --noEmit false --skipLibCheck",
    "check": "bunx --bun depcheck --ignores=\"@types/*,rimraf\" || :",
    "clean": "bun run --bun rimraf bun.lock dist",
    "preinstall": "bunx --bun only-allow bun",
    "lint": "bun run scan && bun run lint:spell && bun run lint:biome && bun run lint:ts",
    "lint:biome": "bun run --bun biome check --write --verbose --error-on-warnings",
    "lint:spell": "bun run --bun cspell --dot --verbose .",
    "lint:ts": "bun run --bun tsc",
    "prepare": "bun run --bun husky",
    "scan": "bun run --bun cve-lite --check-overrides"
  },
  "lint-staged": {
    "*": "bun run --bun cspell --no-must-find-files",
    "*.{json,ts}": "bun run --bun biome ci --error-on-warnings --no-errors-on-unmatched"
  },
  "overrides": {
    "@biomejs/biome": "2.5.9",
    "@types/bun": "1.4.0",
    "@types/node": "26.2.0",
    "cspell": "10.0.1",
    "cve-lite-cli": "1.29.0",
    "globals": "17.11.0",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "rimraf": "^6.1.3"
  },
  "peerDependencies": {
    "@postfmly/config": "^1.4.50"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "^1.4.0"
  },
  "engineStrict": true
}
